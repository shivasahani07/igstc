                                    <input type="date" class="form-control" ng-focus="removeClass('txtIndBD')"
                                        id="txtIndBD" ng-model="pairingDetails.Birthdate"
                                        ng-disabled="proposalStage || primary || pairingDetails.Birthdate" />
                                </div>
                            </div>

                        </div>

                        <div class="col-md-6">
