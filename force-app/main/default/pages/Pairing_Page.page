                                <div class="col-md-12 mt-5">
                                    <label class="font-if">
                                        Email<span class="required-asterisk" style="color:red;">*</span></label>
                                    <input type="text" class="form-control" ng-model="pairingDetails.Email"
                                        ng-focus="removeClass('txtIndEmail')" id="txtIndEmail"
                                        ng-disabled="proposalStage || primary || pairingDetails.Email"
                                        ng-change="checkEmail(pairingDetails.Email,pairingDetails.Id)" />
                                </div>
                                <div class="col-md-12 mt-5">
                                    <label class="font-if">
                                        First Name<span class="required-asterisk" style="color:red;">*</span></label>
                                    <input type="text" class="form-control" ng-focus="removeClass('txtIndFN')"
                                        id="txtIndFN" ng-model="pairingDetails.FirstName"
                                        ng-disabled="proposalStage || primary" />
                                </div>
                                <div class="col-md-12 mt-5">
                                    <label class="font-if">Last Name<span class="required-asterisk"
                                            style="color:red;">*</span></label>
                                    <input type="text" class="form-control" ng-focus="removeClass('txtIndLN')"
                                        id="txtIndLN" ng-model="pairingDetails.LastName"
                                        ng-disabled="proposalStage || primary" />
                                </div>
                                <div class="col-md-12 mt-5">
                                    <label class="font-if">
                                        Institution / Organization<span class="required-asterisk"
                                            style="color:red;">*</span></label>
                                    <input type="text" class="form-control" ng-focus="removeClass('txtIndOrg')"
                                        id="txtIndOrg" ng-model="pairingDetails.Account.Name"
                                        ng-disabled="proposalStage || primary || pairingDetails.Account.Name" />
                                </div>
                                <div class="col-md-12 mt-5 mb-5">
                                    <label class="font-if">Date of Birth
