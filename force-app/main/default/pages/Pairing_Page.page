                                    </i>
                                    <i ng-show="pairList.MailingCountry == 'Germany'">
                                        <apex:image url="{!$Resource.germanyFlag}" styleClass="img-fluid"
                                            style="max-width:30px;" />
                                    </i>
                                    <h4 class="pb-3 pt-2 color-theme w-75 float-end" style="font-weight:700">
                                        {{country2}} Member of the Pair</h4>
